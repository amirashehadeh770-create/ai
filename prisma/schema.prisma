// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Store {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String
  accentColor String   @default("#4f46e5")
  logoUrl     String
  createdAt   DateTime @default(now())

  admins     AdminUser[]
  categories Category[]
  products   Product[]
  orders     Order[]
}

model AdminUser {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String
  storeId      String
  store        Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

model Category {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name    String
  slug    String

  products Product[]

  @@unique([storeId, slug])
}

model Product {
  id          String    @id @default(cuid())
  storeId     String
  store       Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  name        String
  slug        String
  description String
  priceCents  Int
  imageUrl    String
  stock       Int       @default(0)
  createdAt   DateTime  @default(now())

  orderItems OrderItem[]

  @@unique([storeId, slug])
}

model Order {
  id              String   @id @default(cuid())
  storeId         String
  store           Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customerEmail   String
  status          String   @default("pending") // pending | paid | fulfilled | cancelled
  totalCents      Int
  stripeSessionId String?  @unique
  createdAt       DateTime @default(now())

  items OrderItem[]
}

model OrderItem {
  id         String  @id @default(cuid())
  orderId    String
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String
  product    Product @relation(fields: [productId], references: [id])
  quantity   Int
  priceCents Int
}
