# Copy this file to .env.local and fill in the values.

# Random secret used to sign admin session tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Stripe test-mode keys, from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""

# Stripe CLI webhook secret (run `stripe listen --forward-to localhost:3000/api/webhooks/stripe`)
STRIPE_WEBHOOK_SECRET=""
